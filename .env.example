# YoHo 环境变量配置示例
# 🔐 重要：复制此文件为 .env 并填入您的真实 API 密钥
# ⚠️  警告：.env 文件包含敏感信息，请勿提交到 Git 仓库
#
# 📋 配置级别说明：
#   [REQUIRED]    - 必需配置，缺少则无法启动系统
#   [RECOMMENDED] - 推荐配置，缺少会影响功能但不影响启动
#   [OPTIONAL]    - 可选配置，用于高级功能或性能优化

# ==================== 必需配置（系统启动必需） ====================

# [REQUIRED] LLM API 配置 (OpenAI 兼容 API)
# 支持 DeepSeek、通义千问、OpenAI 等任意 OpenAI 兼容 API
YOHO_API_KEY=sk-your-key
YOHO_BASE_URL=https://api.deepseek.com
YOHO_QUICK_MODEL=deepseek-v4-flash
YOHO_DEEP_MODEL=deepseek-v4-pro[1m]
YOHO_QUICK_TEMPERATURE=0.7
YOHO_DEEP_TEMPERATURE=0.3
YOHO_MAX_TOKENS=8192

# ==================== 推荐配置 ====================

# [RECOMMENDED] 数据源 (tushare / akshare)
# akshare 免费无需 Token，tushare 需要 TUSHARE_TOKEN
YOHO_DATA_SOURCE=tushare

# [RECOMMENDED] Tushare Token（当 YOHO_DATA_SOURCE=tushare 时需要）
# 获取地址: https://tushare.pro/
TUSHARE_TOKEN=your-tushare-token

# ==================== Docker 数据库（推荐） ====================

# [RECOMMENDED] MongoDB 数据库（Docker 部署）
# 先启动 docker-compose: docker-compose up -d mongodb
MONGODB_ENABLED=true
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=yoho123
MONGODB_DATABASE=yoho
MONGODB_AUTH_SOURCE=admin
MONGODB_CONNECTION_STRING=mongodb://admin:yoho123@localhost:27017/yoho?authSource=admin

# [RECOMMENDED] Redis 缓存（Docker 部署）
# 先启动 docker-compose: docker-compose up -d redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=yoho123
REDIS_DB=0
REDIS_CONNECTION_STRING=redis://:yoho123@localhost:6379/0

# [OPTIONAL] 缓存策略 (file / integrated)
# file: 仅文件缓存
# integrated: 自适应 Redis > MongoDB > File（需要 MongoDB/Redis 已启用）
TA_CACHE_STRATEGY=integrated

# ==================== 可选配置 ====================

# [OPTIONAL] ChromaDB 长期记忆
YOHO_MEMORY_ENABLED=true
YOHO_MEMORY_PATH=./chroma_db

# [OPTIONAL] 辩论轮次
YOHO_MAX_DEBATE_ROUNDS=1
YOHO_MAX_RISK_ROUNDS=1
YOHO_RECURSION_LIMIT=100

# [OPTIONAL] 日志级别 (DEBUG / INFO / WARNING / ERROR)
YOHO_LOG_LEVEL=INFO

# [OPTIONAL] 时区
TZ=Asia/Shanghai

# ==================== 交易日历校正（自动处理 T-1 问题） ====================

# [OPTIONAL] Tushare 数据就绪截止时间（Asia/Shanghai 时区，小时）
# 交易日当天需 >= 此时刻才认为数据已入库可查；在此之前自动回退到上一交易日
TUSHARE_DATA_READY_HOUR=20

# [OPTIONAL] 交易日历缓存刷新周期（天）
TRADE_CALENDAR_REFRESH_DAYS=365

# [OPTIONAL] 数据存在性回溯步数上限
# 查询某个交易日无数据时，自动向前回溯到最近有数据的交易日，最多回溯此步数
TRADE_DATE_RETRY_STEPS=3

# ==================== 选股层（全市场模式，selectedLayer 含 "screening"） ====================

# [OPTIONAL] 候选池个股上限
YOHO_MAX_SCREENED_STOCKS=10

# [OPTIONAL] 涨幅计算回看天数
YOHO_SCREENING_LOOKBACK_DAYS=10

# [OPTIONAL] 流动性过滤阈值：最新成交额下限（元），默认 5000 万
YOHO_SCREENING_MIN_TURNOVER=50000000

# [OPTIONAL] 每个板块拉取成分股数量上限
YOHO_MAX_CONSTITUENTS=50

# ==================== 仓位管理层（全市场模式，selectedLayer 含 "position"） ====================

# [REQUIRED 全市场模式] 总资金（元）。未配置时仓位管理层跳过并告警
YOHO_TOTAL_CAPITAL=0

# [OPTIONAL] 总仓位上限（占总投资比例）
YOHO_MAX_POSITION_PCT=0.8

# [OPTIONAL] 单票仓位上限
YOHO_MAX_SINGLE_STOCK_PCT=0.1

# [OPTIONAL] 同板块合计仓位上限
YOHO_MAX_SECTOR_PCT=0.3

# [OPTIONAL] 分配策略: equal / confidence_weighted / kelly
YOHO_POSITION_SIZING_STRATEGY=confidence_weighted

# ===== 使用说明 =====
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 编辑 .env 填入真实 API 密钥
# 3. 启动 Docker 服务: docker-compose up -d
# 4. 运行分析: python main.py


# ============================================================
# PostgreSQL 事件研究系统 (docker-compose up -d postgres)
# ============================================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=yoho
PG_PASSWORD=yoho123
PG_DATABASE=yoho
PG_SSLMODE=disable

# 事件研究系统参数（可选，均有默认值）
# EVENT_STUDY_VECTOR_MODEL=BAAI/bge-m3
# HF_ENDPOINT=https://hf-mirror.com
# EVENT_STUDY_MARKET_BENCHMARK=000300.SH
